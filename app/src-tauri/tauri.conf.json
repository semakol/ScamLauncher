{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ScamLauncher",
  "version": "0.0.1",
  "identifier": "ru.semakol.scamlauncher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ScamLauncher",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Game",
    "shortDescription": "Лаунчер Minecraft-сборок",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhEOUZBRjMzOTM1QURGQzUKUldURjMxcVRNNitmalNOL3pCRk55NmZrTGFhQnc1NmhTS1ZCNW1KRUl5MzMvL3ZZem1aNzc3OHEK",
      "endpoints": [
        "https://github.com/semakol/ScamLauncher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
